{
	"$schema": "../../../../infra/targets/schema.json",
	"schemaVersion": 17,
	"target": "reference-production",
	"accountAlias": "reference-production-production",
	"resourceIdentity": {
		"logicalName": "superboard",
		"physicalName": "superboard",
		"previousNames": [],
		"migrationStrategy": "canonical"
	},
	"workersDevSubdomain": "reference-production",
	"zoneName": "reference.example",
	"registrationMode": "allowlist",
	"ssoEnabled": false,
	"features": {
		"billing": true,
		"messaging": false,
		"app": true,
		"products": true,
		"paywalls": true,
		"dynamic-links": true,
		"support": true,
		"analytics": false,
		"marketing": true,
		"onboardings": true,
		"flows": false
	},
	"applicationIdentity": {
		"registrationMode": "open",
		"applicationAudience": "reference-production.application",
		"googleAudiences": [
			"1070077172350-r9legn34b4ue4ahndu364h7i6fhgi1s0.apps.googleusercontent.com",
			"1070077172350-enr69udbu6m6vo2gsjvjqhoneaesr51i.apps.googleusercontent.com",
			"1070077172350-empj1r44188iuscqckckta1ghbajn4sl.apps.googleusercontent.com"
		],
		"appleAudiences": [
			"com.createurs.reference-production"
		],
		"webOrigins": []
	},
	"filePolicy": {
		"maxBytes": 52428800,
		"downloadTicketTtlSeconds": 1800,
		"allowedContentTypes": [
			"application/octet-stream",
			"audio/*",
			"image/jpeg",
			"image/png",
			"text/plain",
			"video/*"
		]
	},
	"mail": {
		"transport": "smtp",
		"provider": "aws-ses",
		"awsRegion": "eu-central-1",
		"configurationSet": "superboard-production",
		"fromName": "SuperBoard",
		"fromAddress": "noreply@reference.example"
	},
	"domains": {
		"api": "api.reference.example",
		"auth": "auth.reference.example",
		"shortlinks": "in.reference.example",
		"sdk": "sdk.reference.example",
		"dashboard": "board.reference.example",
		"site": "board.reference.example",
		"files": "files.reference.example",
		"mcp": "board.reference.example"
	},
	"retiredDomains": [],
	"workers": {
		"api": {
			"production": "superboard-api"
		},
		"site": {
			"production": "superboard-site"
		},
		"billing": {
			"production": "superboard-billing"
		},
		"messaging": {
			"production": "superboard-messaging"
		},
		"email": {
			"production": "superboard-email"
		},
		"identity": {
			"production": "superboard-identity"
		},
		"files": {
			"production": "superboard-files"
		},
		"observability": {
			"production": "superboard-observability"
		},
		"mcp": {
			"production": "superboard-mcp"
		},
		"app": {
			"production": "superboard-app"
		},
		"products": {
			"production": "superboard-products"
		},
		"paywalls": {
			"production": "superboard-paywalls"
		},
		"dynamic-links": {
			"production": "superboard-dynamic-links"
		},
		"support": {
			"production": "superboard-support"
		},
		"marketing": {
			"production": "superboard-marketing"
		},
		"onboardings": {
			"production": "superboard-onboardings"
		},
		"custom": {
			"production": "superboard-custom-reference-production"
		}
	},
	"customWorker": {
		"source": "apps/reference/worker/src/index.ts",
		"packagePath": "apps/reference/worker",
		"description": "SuperBoard reference extension used to validate the custom Worker protocol on mbza.dev.",
		"capabilities": [
			"reference.echo",
			"reference.acceptance"
		],
		"secrets": [
			"CUSTOM_WORKER_TOKEN"
		],
		"vars": {
			"REFERENCE_JOB_RETENTION_DAYS": "30"
		},
		"crons": [
			"0 3 * * *"
		],
		"d1Binding": {
			"binding": "REFERENCE_DB",
			"migrationsDir": "apps/reference/worker/migrations"
		},
		"managedWorkers": [
			{
				"id": "vocals-orchestrator",
				"source": "apps/reference/worker/orchestrators/vocals/src/index.ts",
				"packagePath": "apps/reference/worker/orchestrators/vocals",
				"description": "Reference application vocal-cloning Workflow with a bounded Standard container pool.",
				"workers": {
					"production": "send-users-vocals-orchestrator"
				},
				"secrets": [
					"MODAL_API_KEY",
					"GATEWAY_INTERNAL_TOKEN",
					"R2_ACCESS_KEY_ID",
					"R2_SECRET_ACCESS_KEY"
				],
				"vars": {
					"DISPATCH_LEASE_MS": "3600000",
					"MODAL_TTS_URL": "https://reference-production--reference-production-ttsengine-engine.modal.run",
					"R2_READY_MAX_ATTEMPTS": "60"
				},
				"r2Resource": "customR2",
				"d1Binding": "DB",
				"workflow": {
					"binding": "VOCAL_WORKFLOW",
					"className": "VocalProcessingWorkflow",
					"names": {
						"production": "send-users-vocals-workflows"
					}
				},
				"containers": [
					{
						"binding": "STANDARD",
						"className": "Standard",
						"dockerfile": "apps/reference/worker/orchestrators/vocals/container/Dockerfile",
						"maxInstances": 20,
						"instanceType": "standard-1"
					}
				],
				"durableObjects": [
					{
						"binding": "DISPATCHER",
						"className": "Dispatcher",
						"storage": "legacy-kv"
					}
				],
				"migrations": [
					{
						"tag": "v1",
						"newSqliteClasses": [
							"Standard"
						],
						"newClasses": [
							"Dispatcher"
						]
					}
				]
			},
			{
				"id": "medias-orchestrator",
				"source": "apps/reference/worker/orchestrators/medias/src/index.ts",
				"packagePath": "apps/reference/worker/orchestrators/medias",
				"description": "Reference application media-conversion Workflow with Standard and Premium container pools.",
				"workers": {
					"production": "send-users-medias-orchestrator"
				},
				"secrets": [
					"MODAL_API_KEY",
					"GATEWAY_INTERNAL_TOKEN",
					"R2_ACCESS_KEY_ID",
					"R2_SECRET_ACCESS_KEY"
				],
				"vars": {
					"DISPATCH_LEASE_MS": "3600000",
					"MODAL_ATS_URL": "https://reference-production--reference-production-atsengine-engine.modal.run",
					"MODAL_TTS_URL": "https://reference-production--reference-production-ttsengine-engine.modal.run",
					"R2_READY_MAX_ATTEMPTS": "60"
				},
				"r2Resource": "customR2",
				"watermarkPath": "/img/reference-productionthumb.png",
				"d1Binding": "DB",
				"workflow": {
					"binding": "MEDIA_WORKFLOW",
					"className": "MediaProcessingWorkflow",
					"names": {
						"production": "send-users-medias-workflows"
					}
				},
				"containers": [
					{
						"binding": "STANDARD",
						"className": "Standard",
						"dockerfile": "apps/reference/worker/orchestrators/medias/container/Dockerfile",
						"maxInstances": 20,
						"instanceType": "standard-1"
					},
					{
						"binding": "PREMIUM",
						"className": "Premium",
						"dockerfile": "apps/reference/worker/orchestrators/medias/container/Dockerfile",
						"maxInstances": 10,
						"instanceType": "standard-2"
					}
				],
				"durableObjects": [
					{
						"binding": "DISPATCHER",
						"className": "Dispatcher",
						"storage": "legacy-kv"
					}
				],
				"migrations": [
					{
						"tag": "v1",
						"newSqliteClasses": [
							"Standard",
							"Premium"
						],
						"newClasses": [
							"Dispatcher"
						]
					}
				]
			}
		],
		"runtimeBridge": {
			"filesInputOrigin": "https://files.reference.example",
			"outputFileOrigin": "https://file.reference.example",
			"gatewayOrigin": "https://api.reference.example",
			"gatewayWorker": "api-auth-gateway",
			"gatewaySecretBinding": "INTERNAL_CALLBACK_TOKEN",
			"callbackPaths": [
				"/internal/notify",
				"/ws/vocals/notify",
				"/ws/vocals/progress",
				"/ws/medias/progress",
				"/ws/medias/notify"
			],
			"deploymentStatus": "blocked",
			"blockedReason": "Callbacks and WebSockets are implemented locally. Verify identity mappings, shared callback/JWT secrets, external Durable Objects and notification dispatcher, Files routing and active jobs before changing public routing; retain the legacy gateway for its other routes and existing connections."
		},
		"serviceBindings": [
			{
				"binding": "VOCALS_ORCHESTRATOR",
				"workers": {
					"production": "send-users-vocals-orchestrator"
				}
			},
			{
				"binding": "MEDIAS_ORCHESTRATOR",
				"workers": {
					"production": "send-users-medias-orchestrator"
				}
			},
			{
				"binding": "FILES_SERVICE",
				"workers": {
					"production": "superboard-files"
				}
			}
		]
	},
	"oauth": {
		"dashboardClientId": "superboard-reference-production"
	},
	"authGateway": {
		"issuer": "https://api.reference.example",
		"audience": "superboard",
		"jwksUrl": "https://api.reference.example/.well-known/jwks.json"
	},
	"siteRuntime": {
		"workerLoaderBinding": "LOADER",
		"crons": [
			"* * * * *"
		],
		"observability": {
			"enabled": true,
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true
			},
			"traces": {
				"enabled": true,
				"head_sampling_rate": 0.1
			}
		}
	},
	"publicSurfaceMonitors": [
		{
			"id": "site-preview",
			"url": "https://site.reference.example",
			"healthUrl": "https://site.reference.example/superboard-system/health",
			"description": "Legacy console alias retained during identity migration"
		},
		{
			"id": "legacy-chatwoot",
			"url": "https://chat.reference.example",
			"healthUrl": "https://chat.reference.example/ready",
			"description": "Legacy Chatwoot migration source; keep read-only until SuperBoard Support acceptance and retention sign-off, then remove this monitor with the service"
		}
	],
	"operator": {
		"docsUrl": "https://github.com/mabzadev/superboard/tree/main/docs",
		"email": "mabzadev@gmail.com"
	},
