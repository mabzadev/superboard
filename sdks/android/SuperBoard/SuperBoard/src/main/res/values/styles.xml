<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="SuperBoardDefaultImageButton">
        <item name="android:background">@drawable/bg_ripple_superboard</item>
        <item name="android:inset">0dp</item>
    </style>

    <style name="SuperBoardFullScreenDialogStyle">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/superboard_background_deep</item>
        <item name="android:windowBackground">@color/superboard_background_deep</item>
    </style>

    <style name="SuperBoardLoadingText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/superboard_main_text</item>
    </style>

    <style name="SuperBoardEmptyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/superboard_main_text</item>
    </style>

    <style name="SuperBoardFlatButton">
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@drawable/bg_ripple_superboard</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SuperBoardScreenTitleText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/superboard_main_text</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
    </style>

    <style name="SuperBoardListTitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/superboard_main_text</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="SuperBoardListSubtitleText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/superboard_secondary_text</item>
    </style>

</resources>