{
  "name": "@mbzadev/opengrow-js-sdk",
  "version": "1.0.2",
  "description": "OpenGrow generates dynamic links, tracks attributions, and analyzes referrals, seamlessly directing users to your app or the app store for downloads.",
  "type": "module",
  "main": "./dist/opengrow.umd.cjs",
  "module": "./dist/opengrow.js",
  "browser": "./dist/opengrow.js",
  "exports": {
    ".": {
      "import": "./dist/opengrow.js",
      "require": "./dist/opengrow.umd.cjs",
      "default": "./dist/opengrow.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "webpack-dev-server --config webpack.config.cjs --open",
    "build": "webpack --config webpack.config.cjs",
    "test": "node --test test/opengrow.test.js",
    "test:package": "node --test test/package.test.js",
    "pack:check": "npm pack --dry-run",
    "check": "npm test && npm run build && npm run test:package && npm run pack:check"
  },
  "keywords": [
    "opengrow",
    "javascript",
    "library"
  ],
  "author": "OpenGrow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbzadev/opengrow-platform.git",
    "directory": "sdks/javascript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0",
    "webpack-dev-server": "^4.0.0"
  }
}
