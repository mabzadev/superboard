{
  "name": "@mbzadev/superboard-js-sdk",
  "version": "1.0.2",
  "description": "SuperBoard generates dynamic links, tracks attributions, and analyzes referrals, seamlessly directing users to your app or the app store for downloads.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/superboard.umd.cjs",
  "module": "./dist/superboard.js",
  "browser": "./dist/superboard.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/superboard.js",
      "require": "./dist/superboard.umd.cjs",
      "default": "./dist/superboard.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js",
      "require": "./dist/support.umd.cjs",
      "default": "./dist/support.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "webpack-dev-server --config webpack.config.cjs --open",
    "build": "webpack --config webpack.config.cjs",
    "test": "node --test ../../tests/checks/sdks/javascript/superboard.test.js ../../tests/checks/sdks/javascript/support.test.js ../../tests/checks/sdks/javascript/emdash-store-parity.test.js",
    "test:package": "node --test ../../tests/checks/sdks/javascript/package.test.js",
    "pack:check": "npm pack --dry-run",
    "audit:production": "npm audit --omit=dev --workspaces=false --audit-level=low",
    "audit:development": "npm audit --include=dev --workspaces=false --audit-level=low",
    "audit": "npm run audit:production && npm run audit:development",
    "check": "npm run audit && npm test && npm run build && npm run test:package && npm run pack:check"
  },
  "keywords": [
    "superboard",
    "javascript",
    "library"
  ],
  "author": "SuperBoard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mabzadev/superboard.git",
    "directory": "sdks/javascript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
