{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["DOM", "ES2017"],
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": ["**/*.test.ts"]
}
