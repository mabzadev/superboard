{
	"schemaVersion": 1,
	"upstream": {
		"remote": "https://github.com/emdash-cms/emdash.git",
		"commit": "1717d31b351164a5f78e95fe004ee582c7c50f40",
		"version": "0.35.0"
	},
	"overlay": {
		"root": "scripts/config/emdash-root.overlay.json",
		"generatedFiles": ["package.json", "pnpm-workspace.yaml", ".gitignore", "README.md"],
		"excludedWorktreePaths": [
			".github/dependabot.yml",
			".github/workflows/ci.yml",
			".gitignore",
			".prettierrc",
			"AGENTS.md",
			"CONTRIBUTING.md",
			"LICENSE",
			"README.md",
			"SECURITY.md",
			"package-lock.json",
			"package.json",
			"pnpm-lock.yaml",
			"pnpm-workspace.yaml",
			"Dockerfile",
			"compose.yaml",
			".dockerignore",
			"infra/emdash-bot"
		]
	},
	"compatibility": {
		"eslintImportResolverTypescript": "4.4.5",
		"allowBuilds": {
			"@evilmartians/lefthook": false,
			"@swc/core": true,
			"core-js": false,
			"unrs-resolver": true
		},
		"additionalOverrides": {},
		"patchedDependencies": {
			"miniflare@5.20260815.0-alpha": "patches/miniflare@5.20260815.0-alpha.patch"
		},
		"trustPolicyExclude": ["semver@5.7.2"],
		"virtualStoreType": "project",
		"verifyDepsBeforeRun": "warn",
		"hoistPattern": ["*", "!@cloudflare/workers-types"],
		"resolvePeersFromWorkspaceRoot": false,
		"dedupePeerDependents": false,
		"packageExtensions": {
			"@oslojs/webauthn@1.0.0": {
				"dependencies": {
					"@oslojs/asn1": "1.0.0",
					"@oslojs/binary": "1.0.0",
					"@oslojs/cbor": "1.0.0",
					"@oslojs/crypto": "1.0.0"
				}
			},
			"@oslojs/crypto@1.0.x": {
				"dependencies": {
					"@oslojs/asn1": "1.0.0",
					"@oslojs/binary": "1.0.0"
				}
			},
			"@cloudflare/vitest-plugin@1.0.0": {
				"dependencies": {
					"@cloudflare/workers-types": "4.20260305.1",
					"jsdom": "26.1.0"
				}
			}
		},
		"supportedArchitectures": {
			"os": ["current", "darwin", "linux"],
			"cpu": ["x64", "arm64"]
		}
	}
}
