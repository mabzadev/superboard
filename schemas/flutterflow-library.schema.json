{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://board.mbza.dev/schemas/flutterflow-library.schema.json",
  "title": "SuperBoard FlutterFlow library source contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "displayName",
    "source",
    "remoteProject",
    "releasePolicy",
    "dependencies",
    "libraryValues",
    "widgets",
    "pages",
    "actions",
    "forbiddenAppState"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "owner": { "const": "superboard" },
    "displayName": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "testPath", "workflow"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "testPath": { "$ref": "#/$defs/repositoryPath" },
        "workflow": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "remoteProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectIdVariable",
        "apiKeySecret",
        "githubEnvironment"
      ],
      "properties": {
        "projectIdVariable": { "$ref": "#/$defs/environmentName" },
        "apiKeySecret": { "$ref": "#/$defs/environmentName" },
        "githubEnvironment": { "type": "string", "minLength": 1 }
      }
    },
    "releasePolicy": { "const": "immutable-tag-only" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogId",
          "packageName",
          "sourceVersion",
          "requiredRef"
        ],
        "properties": {
          "catalogId": { "type": "string", "minLength": 1 },
          "packageName": { "type": "string", "minLength": 1 },
          "sourceVersion": { "$ref": "#/$defs/semver" },
          "requiredRef": {
            "type": "string",
            "pattern": "^sdk-[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          }
        }
      }
    },
    "libraryValues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "key", "type", "required"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "key": {
            "type": "string",
            "pattern": "^superboard_[a-z0-9_]+$"
          },
          "type": { "enum": ["string", "boolean", "integer"] },
          "required": { "type": "boolean" },
          "defaultValue": {}
        }
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^superboard[A-Za-z0-9]+$"
        }
      }
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SuperBoard[A-Za-z0-9]+$"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SuperBoard[A-Za-z0-9]+Page$"
      }
    },
    "forbiddenAppState": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    }
  }
}
