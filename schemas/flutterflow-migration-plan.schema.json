{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengrow.dev/schemas/flutterflow-migration-plan.schema.json",
  "title": "OpenGrow FlutterFlow application migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "target",
    "environment",
    "sourceEnvironment",
    "snapshotManifest",
    "surfaceManifest",
    "phases",
    "workItems"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "application": { "$ref": "#/$defs/identifier" },
    "target": { "$ref": "#/$defs/identifier" },
    "environment": { "enum": ["development", "production"] },
    "sourceEnvironment": {
      "type": "string",
      "pattern": "^OPENGROW_CLIENT_SOURCE_[A-Z0-9_]+$"
    },
    "snapshotManifest": { "$ref": "#/$defs/repositoryPath" },
    "surfaceManifest": { "$ref": "#/$defs/repositoryPath" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workItem" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "scope",
        "authority",
        "title",
        "convergenceChecks",
        "legacy",
        "replacementSymbols",
        "acceptance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "phase": { "$ref": "#/$defs/identifier" },
        "scope": {
          "enum": ["common-adoption", "application-custom", "client-quality"]
        },
        "authority": {
          "enum": [
            "identity",
            "app",
            "notifications",
            "files",
            "custom-jobs",
            "billing",
            "support",
            "onboardings",
            "marketing",
            "flutterflow"
          ]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "convergenceChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "legacy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "replacementSymbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
