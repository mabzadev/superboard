{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengrow.local/schemas/cloudflare-deployments.schema.json",
  "title": "OpenGrow Cloudflare deployment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deployments"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "branch",
          "githubEnvironment",
          "cloudflareEnvironment",
          "referenceAcceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "branch": { "enum": ["dev", "main"] },
          "githubEnvironment": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "cloudflareEnvironment": {
            "enum": ["development", "production"]
          },
          "referenceAcceptance": { "type": "boolean" }
        }
      }
    }
  }
}
