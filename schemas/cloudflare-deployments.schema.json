{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengrow.local/schemas/cloudflare-deployments.schema.json",
  "title": "SuperBoard Cloudflare deployment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deployments"],
  "properties": {
    "$schema": { "type": "string" },
  "schemaVersion": { "const": 4 },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "branch",
          "target",
          "githubEnvironment",
          "cloudflareEnvironment",
          "automaticDeployment",
          "referenceAcceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "branch": { "enum": ["dev", "main"] },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$"
          },
          "githubEnvironment": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "cloudflareEnvironment": {
            "enum": ["development", "production"]
          },
          "automaticDeployment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authority",
                  "mode",
                  "services",
                  "buildCommand",
                  "deployCommand",
                  "buildVariables",
                  "nonProductionBranchBuilds"
                ],
                "properties": {
                  "authority": { "const": "cloudflare-workers-builds" },
                  "mode": { "const": "per-service" },
                  "services": {
                    "const": [
                      "observability",
                      "email",
                      "files",
                      "identity",
                      "app",
                      "products",
                      "paywalls",
                      "dynamic-links",
                      "support",
                      "analytics",
                      "marketing",
                      "onboardings",
                      "billing",
                      "custom",
                      "api",
                      "mcp",
                      "dashboard"
                    ]
                  },
                  "buildCommand": {
                    "const": "npm ci && npm --prefix apps/reference ci && node --test scripts/backoffice-policy.test.mjs scripts/github-deployment-matrix.test.mjs scripts/github-deployment-workflow.test.mjs && npm run cloudflare:test:services && npm run typecheck && npm test && npm run custom:check && npm --prefix apps/reference run config:test"
                  },
                  "deployCommand": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 255
                  },
                  "buildVariables": {
                    "const": [
                      "CLOUDFLARE_ACCOUNT_ID",
                      "SUPERBOARD_ENVIRONMENT",
                      "SUPERBOARD_SERVICE",
                      "SUPERBOARD_TARGET"
                    ]
                  },
                  "nonProductionBranchBuilds": { "const": false }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["authority"],
                "properties": {
                  "authority": { "const": "github-actions" }
                }
              }
            ]
          },
          "referenceAcceptance": { "type": "boolean" }
        }
      }
    }
  }
}
