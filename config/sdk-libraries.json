{
  "$schema": "./sdk-libraries.schema.json",
  "schemaVersion": 2,
  "repository": "https://github.com/mbzadev/opengrow-platform",
  "developmentBranch": "dev",
  "releasePolicy": "immutable-tag",
  "libraries": [
    {
      "id": "flutter",
      "displayName": "OpenGrow Flutter",
      "ecosystem": "Flutter",
      "packageName": "opengrow_flutter",
      "sourcePath": "sdks/flutter",
      "license": "MIT",
      "licensePath": "sdks/flutter/LICENSE",
      "versionSource": "sdks/flutter/pubspec.yaml",
      "sourceVersion": "2.1.3",
      "latestReleaseVersion": "2.1.3",
      "releaseRef": "sdk-flutter-v2.1.3",
      "releaseStatus": "released",
      "install": "opengrow_flutter:\n  git:\n    url: https://github.com/mbzadev/opengrow-platform.git\n    ref: sdk-flutter-v2.1.3\n    path: sdks/flutter"
    },
    {
      "id": "flutterflow",
      "displayName": "OpenGrow FlutterFlow",
      "ecosystem": "FlutterFlow",
      "packageName": "opengrow_flutterflow",
      "sourcePath": "sdks/flutterflow",
      "license": "MIT",
      "licensePath": "sdks/flutterflow/LICENSE",
      "versionSource": "sdks/flutterflow/pubspec.yaml",
      "sourceVersion": "2.2.4",
      "latestReleaseVersion": "2.2.4",
      "releaseRef": "sdk-flutterflow-v2.2.4",
      "releaseStatus": "released",
      "surfaceManifest": "config/flutterflow-custom-code.json",
      "install": "opengrow_flutterflow:\n  git:\n    url: https://github.com/mbzadev/opengrow-platform.git\n    ref: sdk-flutterflow-v2.2.4\n    path: sdks/flutterflow"
    },
    {
      "id": "flutterflow-support",
      "displayName": "OpenGrow FlutterFlow Support",
      "ecosystem": "FlutterFlow",
      "packageName": "opengrow_flutterflow_messaging",
      "sourcePath": "sdks/flutterflow_messaging",
      "license": "MIT",
      "licensePath": "sdks/flutterflow_messaging/LICENSE",
      "versionSource": "sdks/flutterflow_messaging/pubspec.yaml",
      "sourceVersion": "1.3.0",
      "latestReleaseVersion": "1.3.0",
      "releaseRef": "sdk-flutterflow-messaging-v1.3.0",
      "releaseStatus": "released",
      "surfaceManifest": "config/flutterflow-custom-code.json",
      "notes": "The package name is retained only for source compatibility; new integrations use the opengrowSupport* API surface.",
      "install": "opengrow_flutterflow_messaging:\n  git:\n    url: https://github.com/mbzadev/opengrow-platform.git\n    ref: sdk-flutterflow-messaging-v1.3.0\n    path: sdks/flutterflow_messaging"
    },
    {
      "id": "ios",
      "displayName": "OpenGrow iOS",
      "ecosystem": "Swift",
      "packageName": "OpenGrow",
      "sourcePath": "sdks/ios",
      "license": "MIT",
      "licensePath": "sdks/ios/LICENSE",
      "versionSource": "sdks/ios/OpenGrow.podspec",
      "sourceVersion": "1.0.2",
      "latestReleaseVersion": "1.0.0",
      "releaseRef": "1.0.0",
      "releaseStatus": "pending-release",
      "install": ".package(url: \"https://github.com/mbzadev/opengrow-platform.git\", exact: \"1.0.0\")"
    },
    {
      "id": "android",
      "displayName": "OpenGrow Android",
      "ecosystem": "Gradle",
      "packageName": "io.opengrow:opengrow-android",
      "sourcePath": "sdks/android/OpenGrow",
      "license": "MIT",
      "licensePath": "sdks/android/LICENSE",
      "versionSource": "sdks/android/OpenGrow/OpenGrow/build.gradle.kts",
      "sourceVersion": "1.0.1",
      "latestReleaseVersion": "1.0.0",
      "releaseRef": "sdk-android-v1.0.0",
      "releaseStatus": "pending-release",
      "install": "implementation(\"io.opengrow:opengrow-android:1.0.0\")"
    },
    {
      "id": "javascript",
      "displayName": "OpenGrow JavaScript",
      "ecosystem": "npm",
      "packageName": "@mbzadev/opengrow-js",
      "sourcePath": "sdks/javascript",
      "license": "MIT",
      "licensePath": "sdks/javascript/LICENSE",
      "versionSource": "sdks/javascript/package.json",
      "sourceVersion": "1.0.1",
      "latestReleaseVersion": "1.0.0",
      "releaseRef": "sdk-js-v1.0.0",
      "releaseStatus": "pending-release",
      "install": "npm install @mbzadev/opengrow-js@1.0.0"
    },
    {
      "id": "react-native",
      "displayName": "OpenGrow React Native",
      "ecosystem": "npm",
      "packageName": "@mbzadev/opengrow-react-native",
      "sourcePath": "sdks/react-native",
      "license": "MIT",
      "licensePath": "sdks/react-native/LICENSE",
      "versionSource": "sdks/react-native/package.json",
      "sourceVersion": "1.0.1",
      "latestReleaseVersion": "1.0.0",
      "releaseRef": "sdk-react-native-v1.0.0",
      "releaseStatus": "pending-release",
      "install": "npm install @mbzadev/opengrow-react-native@1.0.0"
    }
  ]
}
