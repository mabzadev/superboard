{
  "$schema": "./sdk-libraries.schema.json",
  "schemaVersion": 5,
  "repository": "https://github.com/mabzadev/superboard",
  "developmentBranch": "dev",
  "releasePolicy": "immutable-tag",
  "libraries": [
    {
      "id": "flutter",
      "lifecycle": "active",
      "displayName": "SuperBoard Flutter",
      "ecosystem": "Flutter",
      "packageName": "superboard_flutter",
      "sourcePath": "sdks/flutter",
      "license": "MIT",
      "licensePath": "sdks/flutter/LICENSE",
      "versionSource": "sdks/flutter/pubspec.yaml",
      "sourceVersion": "3.0.0",
      "latestReleaseVersion": "3.0.0",
      "releaseRef": "sdk-flutter-v3.0.0",
      "releaseStatus": "released",
      "releaseSha": "1cd57f9d774c272b83f46eaa728fd21352c41e58",
      "install": "superboard_flutter:\n  git:\n    url: https://github.com/mabzadev/superboard.git\n    ref: sdk-flutter-v3.0.0\n    path: sdks/flutter",
      "notes": "SuperBoard 3.0.0 is published as superboard_flutter. The former Dart entrypoints and types remain deprecated compatibility aliases."
    },
    {
      "id": "flutterflow",
      "lifecycle": "active",
      "displayName": "SuperBoard FlutterFlow",
      "ecosystem": "FlutterFlow",
      "packageName": "superboard_flutterflow",
      "sourcePath": "sdks/flutterflow",
      "license": "MIT",
      "licensePath": "sdks/flutterflow/LICENSE",
      "versionSource": "sdks/flutterflow/pubspec.yaml",
      "sourceVersion": "3.0.0",
      "latestReleaseVersion": "3.0.0",
      "releaseRef": "sdk-flutterflow-v3.0.0",
      "releaseStatus": "released",
      "surfaceManifest": "config/flutterflow-custom-code.json",
      "install": "superboard_flutterflow:\n  git:\n    url: https://github.com/mabzadev/superboard.git\n    ref: sdk-flutterflow-v3.0.0\n    path: sdks/flutterflow",
      "releaseSha": "1cd57f9d774c272b83f46eaa728fd21352c41e58",
      "notes": "SuperBoard 3.0.0 is published as the unified superboard_flutterflow package, including authentication, purchases, experiences, links and support."
    },
    {
      "id": "flutterflow-support",
      "lifecycle": "archived",
      "displayName": "SuperBoard FlutterFlow Support",
      "ecosystem": "FlutterFlow",
      "packageName": "opengrow_flutterflow_messaging",
      "sourcePath": "sdks/flutterflow_messaging",
      "license": "MIT",
      "licensePath": "sdks/flutterflow_messaging/LICENSE",
      "versionSource": "sdks/flutterflow_messaging/pubspec.yaml",
      "sourceVersion": "1.3.0",
      "latestReleaseVersion": "1.3.0",
      "releaseRef": "sdk-flutterflow-messaging-v1.3.0",
      "releaseStatus": "released",
      "releaseSha": "e896f8ea91a140419471b02301f0bde48d8d6b13",
      "surfaceManifest": "config/flutterflow-custom-code.json",
      "notes": "Frozen at 1.3.0 for existing clients. Support is now included in the active SuperBoard FlutterFlow package; no new standalone release is allowed.",
      "install": "opengrow_flutterflow_messaging:\n  git:\n    url: https://github.com/mabzadev/superboard.git\n    ref: sdk-flutterflow-messaging-v1.3.0\n    path: sdks/flutterflow_messaging"
    },
    {
      "id": "ios",
      "lifecycle": "internal",
      "displayName": "SuperBoard iOS",
      "ecosystem": "Swift",
      "packageName": "OpenGrow",
      "sourcePath": "sdks/ios",
      "license": "MIT",
      "licensePath": "sdks/ios/LICENSE",
      "versionSource": "sdks/ios/OpenGrow.podspec",
      "sourceVersion": "1.0.3",
      "latestReleaseVersion": "1.0.3",
      "releaseRef": "1.0.3",
      "releaseStatus": "released",
      "releaseSha": "f57894c886956f4043c0c3899c35250548937463",
      "notes": "The 1.0.3 coordinate remains reproducible for existing clients. Native iOS code is now maintained only as an internal implementation of the active Flutter SDK.",
      "install": ".package(url: \"https://github.com/mabzadev/superboard.git\", exact: \"1.0.3\")"
    },
    {
      "id": "android",
      "lifecycle": "internal",
      "displayName": "SuperBoard Android",
      "ecosystem": "Gradle",
      "packageName": "io.opengrow:opengrow-android-sdk",
      "sourcePath": "sdks/android/OpenGrow",
      "license": "MIT",
      "licensePath": "sdks/android/LICENSE",
      "versionSource": "sdks/android/OpenGrow/OpenGrow/build.gradle.kts",
      "sourceVersion": "1.0.3",
      "latestReleaseVersion": "1.0.3",
      "releaseRef": "sdk-android-v1.0.3",
      "releaseStatus": "released",
      "releaseSha": "21549c99fbe65668e0488f0f5ea2fc62219b53c4",
      "notes": "The 1.0.3 coordinate remains reproducible for existing clients. Native Android code is now maintained only as an internal implementation of the active Flutter SDK.",
      "install": "implementation(\"io.opengrow:opengrow-android-sdk:1.0.3\")",
      "distribution": {
        "repository": "mabzadev/superboard-platform",
        "registryKind": "github-packages-maven",
        "registry": "https://maven.pkg.github.com/mabzadev/superboard-platform",
        "publicMetadata": true,
        "anonymousInstallable": false,
        "authentication": {
          "required": true,
          "usernameEnvironmentVariable": "OPENGROW_GITHUB_PACKAGES_USER",
          "tokenEnvironmentVariable": "OPENGROW_GITHUB_PACKAGES_TOKEN"
        }
      }
    },
    {
      "id": "javascript",
      "lifecycle": "archived",
      "displayName": "SuperBoard JavaScript",
      "ecosystem": "npm",
      "packageName": "@mbzadev/opengrow-js-sdk",
      "sourcePath": "sdks/javascript",
      "license": "MIT",
      "licensePath": "sdks/javascript/LICENSE",
      "versionSource": "sdks/javascript/package.json",
      "sourceVersion": "1.0.2",
      "latestReleaseVersion": "1.0.2",
      "releaseRef": "sdk-js-v1.0.2",
      "releaseStatus": "released",
      "releaseSha": "cd27c193c471cf1b22f72a61f38acdd62f7a1e99",
      "notes": "Frozen at 1.0.2 for reproducibility. SuperBoard does not publish or maintain a JavaScript SDK.",
      "install": "npm install @mbzadev/opengrow-js-sdk@1.0.2",
      "distribution": {
        "repository": "mabzadev/superboard-platform",
        "registryKind": "github-packages-npm",
        "registry": "https://npm.pkg.github.com",
        "publicMetadata": true,
        "anonymousInstallable": false,
        "authentication": {
          "required": true,
          "tokenEnvironmentVariable": "OPENGROW_GITHUB_PACKAGES_TOKEN"
        }
      }
    },
    {
      "id": "react-native",
      "lifecycle": "archived",
      "displayName": "SuperBoard React Native",
      "ecosystem": "npm",
      "packageName": "@mbzadev/opengrow-react-native-sdk",
      "sourcePath": "sdks/react-native",
      "license": "MIT",
      "licensePath": "sdks/react-native/LICENSE",
      "versionSource": "sdks/react-native/package.json",
      "sourceVersion": "1.0.2",
      "latestReleaseVersion": "1.0.2",
      "releaseRef": "sdk-react-native-v1.0.2",
      "releaseStatus": "released",
      "releaseSha": "969bacf6f5c52d205ffe6da18cb4c47d85dfbaeb",
      "notes": "Frozen at 1.0.2 for reproducibility. SuperBoard does not publish or maintain a React Native SDK.",
      "install": "npm install @mbzadev/opengrow-react-native-sdk@1.0.2",
      "distribution": {
        "repository": "mabzadev/superboard-platform",
        "registryKind": "github-packages-npm",
        "registry": "https://npm.pkg.github.com",
        "publicMetadata": true,
        "anonymousInstallable": false,
        "authentication": {
          "required": true,
          "tokenEnvironmentVariable": "OPENGROW_GITHUB_PACKAGES_TOKEN"
        }
      }
    },
