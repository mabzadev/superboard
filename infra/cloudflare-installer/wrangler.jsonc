{
	"name": "superboard-installer",
	"main": "worker.mjs",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"observability": { "enabled": false },
	"d1_databases": [
		{
			"binding": "INSTALLER_DB",
			"database_name": "superboard-installations",
			"migrations_dir": "migrations",
		},
	],
}
