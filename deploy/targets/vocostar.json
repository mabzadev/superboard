{
  "$schema": "./schema.json",
  "schemaVersion": 11,
  "target": "vocostar",
  "accountAlias": "vocostar-production",
  "workersDevSubdomain": "vocostar",
  "registrationMode": "allowlist",
  "ssoEnabled": false,
  "features": {
    "billing": true,
    "messaging": false,
    "app": true,
    "products": true,
    "paywalls": true,
    "dynamic-links": true,
    "support": true,
    "marketing": true,
    "onboardings": true
  },
  "applicationIdentity": {
    "registrationMode": "open",
    "applicationAudience": "vocostar.application",
    "googleAudiences": [
      "1070077172350-r9legn34b4ue4ahndu364h7i6fhgi1s0.apps.googleusercontent.com",
      "1070077172350-enr69udbu6m6vo2gsjvjqhoneaesr51i.apps.googleusercontent.com",
      "1070077172350-empj1r44188iuscqckckta1ghbajn4sl.apps.googleusercontent.com"
    ],
    "appleAudiences": ["com.createurs.vocostar"],
    "webOrigins": []
  },
  "filePolicy": {
    "maxBytes": 52428800,
    "downloadTicketTtlSeconds": 1800,
    "allowedContentTypes": [
      "application/octet-stream",
      "audio/*",
      "image/jpeg",
      "image/png",
      "text/plain",
      "video/*"
    ]
  },
  "mail": {
    "transport": "smtp",
    "fromName": "OpenGrow",
    "fromAddress": "noreply@vocostar.com"
  },
  "domains": {
    "api": "api.vocostar.com",
    "shortlinks": "go.vocostar.com",
    "sdk": "sdk.vocostar.com",
    "dashboard": "grow.vocostar.com",
    "files": "files.vocostar.com",
    "mcp": "mcp.vocostar.com",
    "messaging": "messages.vocostar.com"
  },
  "workers": {
    "api": {
      "production": "opengrow-api"
    },
    "dashboard": {
      "production": "opengrow"
    },
    "billing": {
      "production": "opengrow-billing"
    },
    "messaging": {
      "production": "opengrow-messaging"
    },
    "email": {
      "production": "opengrow-email"
    },
    "identity": {
      "production": "opengrow-identity"
    },
    "files": {
      "production": "opengrow-files"
    },
    "observability": {
      "production": "opengrow-observability"
    },
    "mcp": {
      "production": "opengrow-mcp"
    },
    "app": {
      "production": "opengrow-app"
    },
    "products": {
      "production": "opengrow-products"
    },
    "paywalls": {
      "production": "opengrow-paywalls"
    },
    "dynamic-links": {
      "production": "opengrow-dynamic-links"
    },
    "support": {
      "production": "opengrow-support"
    },
    "marketing": {
      "production": "opengrow-marketing"
    },
    "onboardings": {
      "production": "opengrow-onboardings"
    },
    "custom": {
      "production": "opengrow-custom-vocostar"
    }
  },
  "customWorker": {
    "source": "workers/custom/vocostar/src/index.ts",
    "packagePath": "workers/custom/vocostar",
    "description": "VocoStar voice-cloning and media-conversion job adapter backed by the existing Cloudflare Workflows and Containers.",
    "capabilities": [
      "vocostar.voice.clone",
      "vocostar.media.convert",
      "vocostar.jobs.read",
      "vocostar.jobs.cancel",
      "vocostar.jobs.retry"
    ],
    "secrets": ["CUSTOM_WORKER_TOKEN", "FILES_INTERNAL_TOKEN"],
    "vars": {
      "MAX_AUTOMATIC_DISPATCH_ATTEMPTS": "5"
    },
    "crons": ["*/1 * * * *"],
    "d1Binding": {
      "binding": "VOCOSTAR_DB",
      "migrationsDir": "workers/custom/vocostar/migrations"
    },
    "serviceBindings": [
      {
        "binding": "VOCALS_ORCHESTRATOR",
        "workers": {
          "production": "send-users-vocals-orchestrator"
        }
      },
      {
        "binding": "MEDIAS_ORCHESTRATOR",
        "workers": {
          "production": "send-users-medias-orchestrator"
        }
      },
      {
        "binding": "FILES_SERVICE",
        "workers": {
          "production": "opengrow-files"
        }
      }
    ],
    "managedWorkers": [
      {
        "id": "vocals-orchestrator",
        "source": "workers/custom/vocostar/orchestrators/vocals/src/index.ts",
        "packagePath": "workers/custom/vocostar/orchestrators/vocals",
        "description": "VocoStar vocal-cloning Workflow with a bounded Standard container pool.",
        "workers": {
          "production": "send-users-vocals-orchestrator"
        },
        "secrets": [
          "MODAL_API_KEY",
          "GATEWAY_INTERNAL_TOKEN",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY"
        ],
        "vars": {
          "DISPATCH_LEASE_MS": "3600000",
          "MODAL_TTS_URL": "https://vocostar--vocostar-ttsengine-engine.modal.run",
          "R2_READY_MAX_ATTEMPTS": "60"
        },
        "r2Resource": "customR2",
        "d1Binding": "DB",
        "workflow": {
          "binding": "VOCAL_WORKFLOW",
          "className": "VocalProcessingWorkflow",
          "names": {
            "production": "send-users-vocals-workflows"
          }
        },
        "containers": [
          {
            "binding": "STANDARD",
            "className": "Standard",
            "dockerfile": "workers/custom/vocostar/orchestrators/vocals/container/Dockerfile",
            "maxInstances": 20,
            "instanceType": "standard-1"
          }
        ],
        "durableObjects": [
          {
            "binding": "DISPATCHER",
            "className": "Dispatcher",
            "storage": "legacy-kv"
          }
        ],
        "migrations": [
          {
            "tag": "v1",
            "newSqliteClasses": ["Standard"],
            "newClasses": ["Dispatcher"]
          }
        ]
      },
      {
        "id": "medias-orchestrator",
        "source": "workers/custom/vocostar/orchestrators/medias/src/index.ts",
        "packagePath": "workers/custom/vocostar/orchestrators/medias",
        "description": "VocoStar media-conversion Workflow with Standard and Premium container pools.",
        "workers": {
          "production": "send-users-medias-orchestrator"
        },
        "secrets": [
          "MODAL_API_KEY",
          "GATEWAY_INTERNAL_TOKEN",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY"
        ],
        "vars": {
          "DISPATCH_LEASE_MS": "3600000",
          "MODAL_ATS_URL": "https://vocostar--vocostar-atsengine-engine.modal.run",
          "MODAL_TTS_URL": "https://vocostar--vocostar-ttsengine-engine.modal.run",
          "R2_READY_MAX_ATTEMPTS": "60"
        },
        "r2Resource": "customR2",
        "watermarkPath": "/img/vocostarthumb.png",
        "d1Binding": "DB",
        "workflow": {
          "binding": "MEDIA_WORKFLOW",
          "className": "MediaProcessingWorkflow",
          "names": {
            "production": "send-users-medias-workflows"
          }
        },
        "containers": [
          {
            "binding": "STANDARD",
            "className": "Standard",
            "dockerfile": "workers/custom/vocostar/orchestrators/medias/container/Dockerfile",
            "maxInstances": 20,
            "instanceType": "standard-1"
          },
          {
            "binding": "PREMIUM",
            "className": "Premium",
            "dockerfile": "workers/custom/vocostar/orchestrators/medias/container/Dockerfile",
            "maxInstances": 10,
            "instanceType": "standard-2"
          }
        ],
        "durableObjects": [
          {
            "binding": "DISPATCHER",
            "className": "Dispatcher",
            "storage": "legacy-kv"
          }
        ],
        "migrations": [
          {
            "tag": "v1",
            "newSqliteClasses": ["Standard", "Premium"],
            "newClasses": ["Dispatcher"]
          }
        ]
      }
    ],
    "runtimeBridge": {
      "filesInputOrigin": "https://files.vocostar.com",
      "outputFileOrigin": "https://file.vocostar.com",
      "gatewayOrigin": "https://api.vocostar.com",
      "gatewayWorker": "api-auth-gateway",
      "gatewaySecretBinding": "INTERNAL_CALLBACK_TOKEN",
      "callbackPaths": [
        "/internal/notify",
        "/ws/vocals/notify",
        "/ws/vocals/progress",
        "/ws/medias/progress"
      ],
      "deploymentStatus": "blocked",
      "blockedReason": "OpenGrow Files routing is staged and the callback routes are still owned by the external legacy api-auth-gateway; do not replace api.vocostar.com or activate these orchestrators until a reviewed cutover ports the callbacks and coordinates INTERNAL_CALLBACK_TOKEN."
    }
  },
  "oauth": {
    "dashboardClientId": "opengrow-vocostar"
  },
  "authGateway": {
    "issuer": "https://api.vocostar.com",
    "audience": "opengrow",
    "jwksUrl": "https://api.vocostar.com/.well-known/jwks.json"
  },
  "publicSurfaceMonitors": [
    {
      "id": "legacy-chatwoot",
      "url": "https://chat.vocostar.com",
      "healthUrl": "https://chat.vocostar.com/ready",
      "description": "Legacy Chatwoot migration source; keep read-only until OpenGrow Support acceptance and retention sign-off, then remove this monitor with the service"
    }
  ],
  "operator": {
    "docsUrl": "https://github.com/mbzadev/opengrow-platform/tree/main/docs"
  },
