{
  "$schema": "./schema.json",
  "schemaVersion": 9,
  "target": "mbza-development",
  "accountAlias": "mbza-development",
  "workersDevSubdomain": "mbza",
  "registrationMode": "allowlist",
  "ssoEnabled": false,
  "features": {
    "billing": true,
    "messaging": false,
    "app": true,
    "products": true,
    "paywalls": true,
    "dynamic-links": true,
    "support": true,
    "marketing": true,
    "onboardings": true
  },
  "applicationIdentity": {
    "registrationMode": "open",
    "applicationAudience": "mbza-development.application",
    "googleAudiences": [],
    "appleAudiences": [],
    "webOrigins": ["https://reference.mbza.dev"]
  },
  "filePolicy": {
    "maxBytes": 10485760,
    "downloadTicketTtlSeconds": 600,
    "allowedContentTypes": [
      "application/json",
      "application/octet-stream",
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "mail": {
    "transport": "capture",
    "fromName": "OpenGrow Development",
    "fromAddress": "noreply@mbza.dev",
    "replyToAddress": "support@mbza.dev"
  },
  "domains": {
    "api": "api.mbza.dev",
    "shortlinks": "in.mbza.dev",
    "sdk": "sdk.mbza.dev",
    "dashboard": "grow.mbza.dev",
    "files": "files.mbza.dev",
    "mcp": "mcp.mbza.dev",
    "mailPreview": "mail.mbza.dev"
  },
  "workers": {
    "api": {
      "development": "opengrow-api-dev"
    },
    "dashboard": {
      "development": "opengrow-dashboard-dev"
    },
    "billing": {
      "development": "opengrow-billing-dev"
    },
    "email": {
      "development": "opengrow-email-dev"
    },
    "identity": {
      "development": "opengrow-identity-dev"
    },
    "files": {
      "development": "opengrow-files-dev"
    },
    "observability": {
      "development": "opengrow-observability-dev"
    },
    "mcp": {
      "development": "opengrow-mcp-dev"
    },
    "app": {
      "development": "opengrow-app-dev"
    },
    "products": {
      "development": "opengrow-products-dev"
    },
    "paywalls": {
      "development": "opengrow-paywalls-dev"
    },
    "dynamic-links": {
      "development": "opengrow-dynamic-links-dev"
    },
    "support": {
      "development": "opengrow-support-dev"
    },
    "marketing": {
      "development": "opengrow-marketing-dev"
    },
    "onboardings": {
      "development": "opengrow-onboardings-dev"
    },
    "custom": {
      "development": "opengrow-custom-reference-dev"
    }
  },
  "customWorker": {
    "source": "workers/custom/reference/src/index.ts",
    "packagePath": "workers/custom/reference",
    "description": "OpenGrow reference extension used to validate the custom Worker protocol on mbza.dev.",
    "capabilities": ["reference.echo", "reference.acceptance"],
    "secrets": ["CUSTOM_WORKER_TOKEN"],
    "vars": {
      "REFERENCE_JOB_RETENTION_DAYS": "30"
    },
    "crons": ["0 3 * * *"],
    "d1Binding": {
      "binding": "REFERENCE_DB",
      "migrationsDir": "workers/custom/reference/migrations"
    }
  },
  "oauth": {
    "dashboardClientId": "opengrow-mbza-development"
  },
  "authGateway": {
    "issuer": "https://api.mbza.dev",
    "audience": "opengrow",
    "jwksUrl": "https://api.mbza.dev/.well-known/jwks.json"
  },
  "publicSurfaceMonitors": [
    {
      "id": "reference",
      "url": "https://reference.mbza.dev",
      "healthUrl": "https://reference.mbza.dev/",
      "description": "Executable Flutter Web acceptance application for the common OpenGrow journeys"
    }
  ],
  "operator": {
    "docsUrl": "https://github.com/mbzadev/opengrow-platform/tree/dev/docs",
    "supportEmail": "support@mbza.dev"
  },
  "environments": {
    "development": {
      "d1": {
        "name": "opengrow-dev-db",
        "id": "e04af85c-d329-4026-a269-20816948729f"
      },
      "kv": {
