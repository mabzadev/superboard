{
  "$schema": "./schema.json",
  "schemaVersion": 17,
  "target": "mbza-development",
  "accountAlias": "mbza-development",
  "resourceIdentity": {
    "logicalName": "superboard",
    "physicalName": "superboard",
    "previousNames": [],
    "migrationStrategy": "canonical"
  },
  "workersDevSubdomain": "mbza",
  "zoneName": "mbza.dev",
  "registrationMode": "allowlist",
  "ssoEnabled": false,
  "features": {
    "billing": true,
    "messaging": false,
    "app": true,
    "products": true,
    "paywalls": true,
    "dynamic-links": true,
    "support": true,
    "analytics": true,
    "marketing": true,
    "onboardings": true,
    "flows": true
  },
  "applicationIdentity": {
    "registrationMode": "open",
    "applicationAudience": "mbza-development.application",
    "googleAudiences": [],
    "appleAudiences": [],
    "webOrigins": [
      "https://reference.mbza.dev"
    ]
  },
  "filePolicy": {
    "maxBytes": 10485760,
    "downloadTicketTtlSeconds": 600,
    "allowedContentTypes": [
      "application/json",
      "application/octet-stream",
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "mail": {
    "transport": "smtp",
    "provider": "aws-ses",
    "awsRegion": "eu-central-1",
    "configurationSet": "superboard-development",
    "fromName": "SuperBoard Development",
    "fromAddress": "noreply@mbza.dev",
    "replyToAddress": "support@mbza.dev"
  },
  "domains": {
    "api": "api.mbza.dev",
    "auth": "auth.mbza.dev",
    "shortlinks": "in.mbza.dev",
    "sdk": "sdk.mbza.dev",
    "dashboard": "board.mbza.dev",
    "site": "site.mbza.dev",
    "files": "files.mbza.dev",
    "mcp": "mcp.mbza.dev",
    "mailPreview": "mail.mbza.dev"
  },
  "retiredDomains": [
    {
      "hostname": "grow.mbza.dev",
      "formerSurface": "dashboard",
      "policy": "must-be-unassigned",
      "reason": "Previous back-office hostname replaced by board.mbza.dev."
    }
  ],
  "workers": {
    "api": {
      "development": "superboard-api-dev",
      "local": "superboard-api-local"
    },
    "site": {
      "development": "superboard-site-dev",
      "local": "superboard-site-local"
    },
    "dashboard": {
      "development": "superboard-dashboard-dev",
      "local": "superboard-dashboard-local"
    },
    "billing": {
      "development": "superboard-billing-dev",
      "local": "superboard-billing-local"
    },
    "email": {
      "development": "superboard-email-dev",
      "local": "superboard-email-local"
    },
    "identity": {
      "development": "superboard-identity-dev",
      "local": "superboard-identity-local"
    },
    "files": {
      "development": "superboard-files-dev",
      "local": "superboard-files-local"
    },
    "observability": {
      "development": "superboard-observability-dev",
      "local": "superboard-observability-local"
    },
    "mcp": {
      "development": "superboard-mcp-dev",
      "local": "superboard-mcp-local"
    },
    "app": {
      "development": "superboard-app-dev",
      "local": "superboard-app-local"
    },
    "products": {
      "development": "superboard-products-dev",
      "local": "superboard-products-local"
    },
    "paywalls": {
      "development": "superboard-paywalls-dev",
      "local": "superboard-paywalls-local"
    },
    "dynamic-links": {
      "development": "superboard-dynamic-links-dev",
      "local": "superboard-dynamic-links-local"
    },
    "support": {
      "development": "superboard-support-dev",
      "local": "superboard-support-local"
    },
    "analytics": {
      "development": "superboard-analytics-dev",
      "local": "superboard-analytics-local"
    },
    "marketing": {
      "development": "superboard-marketing-dev",
      "local": "superboard-marketing-local"
    },
    "onboardings": {
      "development": "superboard-onboardings-dev",
      "local": "superboard-onboardings-local"
    },
    "flows": {
      "development": "superboard-flows-dev",
      "local": "superboard-flows-local"
    },
    "custom": {
      "development": "superboard-custom-reference-dev",
      "local": "superboard-custom-reference-local"
    }
  },
  "customWorker": {
    "source": "workers/custom/reference/src/index.ts",
    "packagePath": "workers/custom/reference",
    "description": "SuperBoard reference extension used to validate the custom Worker protocol on mbza.dev.",
    "capabilities": [
      "reference.echo",
      "reference.acceptance"
    ],
    "secrets": [
      "CUSTOM_WORKER_TOKEN"
    ],
    "vars": {
      "REFERENCE_JOB_RETENTION_DAYS": "30"
    },
    "crons": [
      "0 3 * * *"
    ],
    "d1Binding": {
      "binding": "REFERENCE_DB",
      "migrationsDir": "workers/custom/reference/migrations"
    }
  },
  "oauth": {
    "dashboardClientId": "superboard-mbza-development"
  },
  "authGateway": {
    "issuer": "https://auth.mbza.dev",
    "audience": "superboard",
    "jwksUrl": "https://auth.mbza.dev/.well-known/jwks.json"
  },
  "siteRuntime": {
    "workerLoaderBinding": "LOADER",
    "crons": [
      "* * * * *"
    ],
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 0.1
      }
    }
  },
  "publicSurfaceMonitors": [
    {
      "id": "site-preview",
      "url": "https://site.mbza.dev",
      "healthUrl": "https://site.mbza.dev/superboard-system/health",
      "description": "Staged Site EmDash preview; it does not own Dashboard traffic"
    },
    {
      "id": "reference",
      "url": "https://reference.mbza.dev",
      "healthUrl": "https://reference.mbza.dev/",
      "description": "Executable Flutter Web acceptance application for the common SuperBoard journeys"
    }
  ],
  "operator": {
    "docsUrl": "https://github.com/mabzadev/superboard/tree/dev/docs",
    "email": "mabzadev@gmail.com",
    "supportEmail": "support@mbza.dev"
  },
