{
  "name": "@superboard/dashboard",
  "version": "0.1.1",
  "type": "module",
  "description": "Reusable operator back office for application infrastructure, identity, support, growth, and purchases",
  "author": "appssemble",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mabzadev/superboard.git",
    "directory": "apps/dashboard"
  },
  "bugs": {
    "url": "https://github.com/mabzadev/superboard/issues"
  },
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:test": "cross-env NEXT_PUBLIC_ENV=test next build",
    "build:prod": "cross-env NEXT_PUBLIC_ENV=production next build",
    "cf:build": "node ../../scripts/dashboard-cloudflare.mjs",
    "cf:preview": "node ../../scripts/dashboard-cloudflare.mjs --preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:support": "cross-env NEXT_PUBLIC_API_URL=https://api.example.test NEXT_PUBLIC_AUTH_URL=https://auth.example.test NEXT_PUBLIC_CLIENT_ID=support-ci NEXT_PUBLIC_DOCS_URL=https://docs.example.test NEXT_PUBLIC_SDK_URL=https://sdk.example.test NEXT_PUBLIC_SHORTLINK_URL=https://links.example.test NEXT_PUBLIC_MCP_URL=https://mcp.example.test vitest run src/api/support/__tests__/nativeServices.test.ts src/components/modules/__tests__/SupportNativePages.test.tsx src/components/modules/__tests__/SupportIntegrationsPage.test.tsx \"src/app/(protected)/support/__tests__/redirects.test.ts\"",
    "build:support": "cross-env NEXT_PUBLIC_API_URL=https://api.example.test NEXT_PUBLIC_AUTH_URL=https://auth.example.test NEXT_PUBLIC_CLIENT_ID=support-ci NEXT_PUBLIC_DOCS_URL=https://docs.example.test NEXT_PUBLIC_SDK_URL=https://sdk.example.test NEXT_PUBLIC_SHORTLINK_URL=https://links.example.test NEXT_PUBLIC_MCP_URL=https://mcp.example.test NEXT_PUBLIC_ENV=test next build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@superboard/contracts": "workspace:*",
