{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@melody-auth/react": [
        "./src/identity/melody-react.tsx"
      ],
      "app/Setup": [
        "./src/identity/Setup.tsx"
      ],
      "app/useSignalValue": [
        "./src/identity/useSignalValue.ts"
      ],
      "app/[lang]/*": [
        "./src/app/(protected)/identity/[lang]/*"
      ],
      "components/*": [
        "./src/identity/components/*"
      ],
      "hooks/*": [
        "./src/identity/hooks/*"
      ],
      "i18n/*": [
        "./src/identity/i18n/*"
      ],
      "identity/*": [
        "./src/identity/*"
      ],
      "identity-route/*": [
        "./src/app/(protected)/identity/[lang]/*"
      ],
      "services/*": [
        "./src/identity/services/*"
      ],
      "signals": [
        "./src/identity/signals/index.ts"
      ],
      "signals/*": [
        "./src/identity/signals/*"
      ],
      "stores": [
        "./src/identity/stores/index.tsx"
      ],
      "stores/*": [
        "./src/identity/stores/*"
      ],
      "tools": [
        "./src/identity/tools/index.ts"
      ],
      "tools/*": [
        "./src/identity/tools/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts"
  ]
}
