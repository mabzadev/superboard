# ===========================================
# SuperBoard Web App - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# -------------------------------------------
# Core API
# -------------------------------------------
NEXT_PUBLIC_API_URL=https://your-api-url.com
NEXT_PUBLIC_AUTH_URL=https://your-auth-url.com
NEXT_PUBLIC_API_PATH=/api/v1
NEXT_PUBLIC_ENV=test

# -------------------------------------------
# OAuth Credentials
# -------------------------------------------
NEXT_PUBLIC_CLIENT_ID=your-client-id
NEXT_PUBLIC_DOCS_URL=https://github.com/your-org/superboard/tree/dev/docs
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SDK_URL=https://sdk.example.com
NEXT_PUBLIC_SHORTLINK_URL=https://in.example.com
NEXT_PUBLIC_MCP_URL=https://mcp.example.com

# Server-only secret (never exposed to browser)
CLIENT_SECRET=your-client-secret

# -------------------------------------------
# Firebase (optional — hosting & analytics only)
# -------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -------------------------------------------
# Deployment policy
# -------------------------------------------
NEXT_PUBLIC_REGISTRATION_MODE=allowlist
NEXT_PUBLIC_SSO_ENABLED=false

# -------------------------------------------
# Analytics (optional)
# -------------------------------------------
NEXT_PUBLIC_GTM_ID=
