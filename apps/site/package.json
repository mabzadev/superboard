{
  "name": "@superboard/site",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm -r --filter \"@superboard/plugin-*\" build && node scripts/build-front-catalog.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "types": "wrangler types",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.menu.config.ts && vitest run --config vitest.front.config.ts && vitest run --config vitest.packages.config.ts && vitest run --config vitest.runtime.config.ts && pnpm run test:runtime:development",
    "test:front": "vitest run --config vitest.front.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:runtime:development": "SUPERBOARD_TEST_ENVIRONMENT=development vitest run --config vitest.runtime.config.ts ../../tests/checks/apps/site/runtime/operational-plugin-activation.runtime.test.ts",
    "dry-run": "astro build && wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@astrojs/react": "catalog:",
    "@emdash-cms/auth": "workspace:*",
    "@emdash-cms/cloudflare": "workspace:*",
    "@lingui/core": "catalog:",
    "@noble/secp256k1": "^3.0.0",
    "@superboard/contracts": "workspace:*",
    "@superboard/front-ui": "workspace:*",
    "@superboard/plugin-analytics": "workspace:*",
    "@superboard/plugin-commerce": "workspace:*",
    "@superboard/plugin-communication": "workspace:*",
    "@superboard/plugin-core": "workspace:*",
    "@superboard/plugin-data": "workspace:*",
    "@superboard/plugin-identity": "workspace:*",
    "@superboard/plugin-journeys": "workspace:*",
    "@superboard/plugin-support": "workspace:*",
    "@superboard/supbrd-core": "workspace:*",
    "astro": "catalog:",
    "emdash": "workspace:*",
    "kysely": "catalog:",
    "layerr": "^3.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@tailwindcss/postcss": "^4",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.25.12",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
