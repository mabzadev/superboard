---
import FrontPage from "../../components/FrontPage.astro";
import { resolveSiteFrontPage } from "../../lib/front-page.js";
import { getSiteEnv } from "../../lib/site-env.js";
import { createUserFrontI18n, resolveUserFrontLocale } from "../../lib/user-front-i18n.js";

export const prerender = false;

if (!Astro.locals.user) {
	return Astro.redirect("/_emdash/admin/login?redirect=%2Fsuperboard-system%2Fhome", 302);
}
const locale = resolveUserFrontLocale(Astro.url.searchParams.get("lang") ?? Astro.request.headers.get("accept-language"));
const i18n = createUserFrontI18n(locale);
const model = await resolveSiteFrontPage(getSiteEnv(), Astro.url.pathname, Astro.locals.user);
---

{model.release ? <FrontPage model={model} /> : (
	<html lang={locale}>
		<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex, nofollow" /><title>{i18n._("site.operator.home")}</title></head>
		<body class="core-operator-home">
			<main>
				<h1>{i18n._("site.operator.home")}</h1>
				<p>{Astro.locals.user.name ?? Astro.locals.user.email}</p>
				<p>{i18n._("site.operator.home_description")}</p>
				<a href="/_emdash/admin">{i18n._("site.admin.open")}</a>
			</main>
		</body>
	</html>
)}

<style>
	:global(body.core-operator-home) { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: light-dark(#f8fafc, #111827); color: light-dark(#111827, #f8fafc); color-scheme: light dark; }
	main { width: min(36rem, calc(100% - 3rem)); margin-inline: auto; padding-block: 3rem; }
	a { display: inline-block; margin-block-start: 1rem; color: inherit; }
</style>

<script>
	import { watchPluginLifecycle } from "@superboard/front-ui/lifecycle";
	if (document.querySelector(".core-operator-home")) watchPluginLifecycle();
</script>
