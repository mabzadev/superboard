---
import { getEmDashEntry, getMenu } from "emdash";

import type { FrontPageModel } from "../lib/front-page.js";
import {
	editableNavigationFromMenu,
	editableViewFromEntry,
	frontViewSlug,
} from "../lib/native-front-views.js";
import {
	projectNativeFrontPresentation,
	renderedContentRequiresProjectScope,
} from "../lib/native-front-presentation.js";
import { ensureSuperBoardViews } from "../lib/superboard-views.js";
import { createUserFrontI18n, resolveUserFrontRequestLocale } from "../lib/user-front-i18n.js";
import { NativeFrontApp } from "./NativeFrontApp.js";
import { resolveOperatorProjectScope } from "../lib/operator-project-scope.js";
import { getSiteEnv } from "../lib/site-env.js";

import "@superboard/front-ui/styles/kumo.css";
import "../styles/dashboard-views.css";
import "../styles/native-front.css";
// Imported last on purpose: its :root font tokens must follow the Kumo/Tailwind layers.
import "@superboard/front-ui/styles/fonts.css";

interface Props {
	model: FrontPageModel;
}

const { model } = Astro.props;
const locale = resolveUserFrontRequestLocale(Astro.request);
Astro.response.headers.set("Content-Language", locale);
let configuration;
// The scope request only depends on the resolved renderers, so it runs alongside the
// editorial view and menu reads instead of after them. On failure, the authenticated POST
// bootstrap resolves absent core projections in the client.
const projectScope =
	model.operator && renderedContentRequiresProjectScope(model)
		? resolveOperatorProjectScope(getSiteEnv(), model.operator).catch(() => undefined)
		: undefined;
if (model.resolution.result === "rendered" && model.operator) {
	await ensureSuperBoardViews(Astro.locals.emdash.db);
	const route = model.release?.release.payload.front_route_manifest.routes.find(({ route_id }) => route_id === model.resolution.route_id);
	const [menu, viewResult] = await Promise.all([
		getMenu("superboard-admin", { locale }),
		getEmDashEntry("views", frontViewSlug(route?.path_pattern ?? model.requested_path)),
	]);
	configuration = {
		navigation: editableNavigationFromMenu(menu),
		view: editableViewFromEntry(viewResult.entry, model.release?.release.payload ?? null),
	};
}
const projection = projectNativeFrontPresentation(model, locale, configuration);
projection.operator = model.operator;
const resolvedProjectScope = await projectScope;
if (resolvedProjectScope) projection.project_scope = resolvedProjectScope;
const i18n = createUserFrontI18n(locale);
// Loaded without blocking render; "Geist Mono" (self-hosted) covers the swap period.
const sourceCodeProStylesheet =
	"https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,400;0,500;0,600;1,400&display=swap";
const viewTitle = projection.content_mounts[0]?.view_title ?? model.page_title;
const title = viewTitle ? (Object.hasOwn(projection.messages, viewTitle) ? i18n._(viewTitle) : viewTitle) : i18n._("site.front.title");
---

<!doctype html>
<html lang={locale} dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="superboard-release-id" content={projection.release_id ?? ""} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href={sourceCodeProStylesheet}
			media="print"
			onload="this.media='all'"
		/>
		<noscript><link rel="stylesheet" href={sourceCodeProStylesheet} /></noscript>
		<script is:inline define:vars={{ instanceId: model.instance_id }}>
			// Mirrors the next-themes provider in FrontRuntimeProviders (same storage key,
			// defaultTheme "system") so the first paint matches the hydrated theme.
			(() => {
				const storageKey = `superboard:${instanceId}:theme`;
				let storedPreference = null;
				try {
					storedPreference = localStorage.getItem(storageKey);
					if (!storedPreference) {
						const legacyPreference =
							localStorage.getItem("superboard-theme") || localStorage.getItem("theme");
						if (
							legacyPreference === "light" ||
							legacyPreference === "dark" ||
							legacyPreference === "system"
						) {
							storedPreference = legacyPreference;
							localStorage.setItem(storageKey, legacyPreference);
						}
					}
				} catch {
					// Storage can be unavailable in privacy-restricted contexts.
				}
				const preference =
					storedPreference === "light" || storedPreference === "dark"
						? storedPreference
						: window.matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light";
				const root = document.documentElement;
				root.classList.remove("light", "dark");
				root.classList.add(preference);
				root.setAttribute("data-theme", preference);
				root.setAttribute("data-mode", preference);
				root.style.colorScheme = preference;
			})();
		</script>
	</head>
	<body>
		<NativeFrontApp projection={projection} client:only="react" />
	</body>
</html>
