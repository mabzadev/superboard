---
import type { FrontPageModel } from "../lib/front-page.js";
import {
	mountUserRenderer,
	USER_RENDERER_IDS,
} from "@superboard/supbrd-plug-user";
import {
	createUserFrontI18n,
	resolveUserFrontLocale,
	type UserFrontLocale,
	type UserFrontMessageId,
} from "../lib/user-front-i18n.js";

interface Props {
	model: FrontPageModel;
}

const { model } = Astro.props;
const previewTheme = Astro.url.searchParams.get("theme") === "light" ? "light" : "dark";
const requestedLocale = Astro.url.searchParams.get("lang") ?? Astro.request.headers.get("accept-language") ?? "en";
const locale: UserFrontLocale = resolveUserFrontLocale(requestedLocale);
const i18n = createUserFrontI18n(locale);
const message = (id: UserFrontMessageId) => i18n._(id);
const localizedPageTitle = model.page_title && i18n.messages[model.page_title]
	? i18n._(model.page_title)
	: model.page_title;
const { resolution } = model;
const releaseId = model.release?.release.payload.release_id ?? null;
const coreActionUrls = { "emdash.core.action.admin_session_start": "/_emdash/admin/login" } as const;
const userRendererViews = resolution.result === "rendered"
	? resolution.renderer_ids.flatMap((rendererId) => {
		const props = rendererId === USER_RENDERER_IDS.login
			? { kind: "login" as const, title_message_id: "user.page.sign_in" as const }
			: rendererId === USER_RENDERER_IDS.profile && model.operator
				? { kind: "profile" as const, operator: model.operator }
				: rendererId === USER_RENDERER_IDS.members
					? { kind: "members" as const, page_size: 25, members: model.members }
					: null;
		if (!props) return [];
		return [mountUserRenderer({
			renderer_id: rendererId,
			props,
		})];
	})
	: [];
const stateTitle = {
	maintenance: message("site.front.unavailable"),
	not_found: message("site.front.not_found"),
	forbidden: message("site.front.forbidden"),
	unavailable: message("site.front.dependency_unavailable"),
}[resolution.result as "maintenance" | "not_found" | "forbidden" | "unavailable"];
---

<!doctype html>
<html lang={locale} data-theme={previewTheme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{localizedPageTitle ?? stateTitle ?? "SuperBoard"}</title>
		<style>
			:root {
				color-scheme: dark;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #070b14;
				color: #f4f7fb;
			}
			* { box-sizing: border-box; }
			body { margin: 0; min-height: 100vh; background: radial-gradient(circle at 15% 0%, #162d4d 0, transparent 36%), #070b14; }
			.shell { min-height: 100vh; display: grid; grid-template-rows: auto 1fr; }
			header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid #263348; background: #0a101dcc; backdrop-filter: blur(18px); }
			.brand { font-weight: 760; letter-spacing: -0.03em; }
			a { color: #9cc8ff; }
			.admin-link { text-decoration: none; border: 1px solid #385176; padding: 0.55rem 0.8rem; border-radius: 0.65rem; }
			main { width: min(76rem, 100%); margin: auto; padding: 3rem 1.5rem; }
			.panel { border: 1px solid #27364e; border-radius: 1rem; padding: clamp(1.4rem, 4vw, 3rem); background: #0d1524e8; box-shadow: 0 2rem 5rem #0007; }
			.eyebrow { color: #8bbcff; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
			h1 { margin: 0.5rem 0 0.8rem; font-size: clamp(2rem, 7vw, 4.5rem); letter-spacing: -0.055em; line-height: 0.98; }
			p { max-width: 48rem; color: #bac6d8; line-height: 1.7; }
			.meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
			.meta span { border: 1px solid #2b3c57; border-radius: 999px; padding: 0.4rem 0.65rem; color: #91a4bf; font: 0.75rem ui-monospace, SFMono-Regular, Menlo, monospace; }
			.renderers { display: grid; gap: 0.8rem; margin-top: 1.5rem; }
			.renderer { border: 1px dashed #3d5273; border-radius: 0.75rem; padding: 1rem; background: #0a111f; color: #c9d4e4; }
			.renderer h2 { margin: 0 0 0.35rem; }
			.action { display: inline-flex; margin-top: 0.6rem; border: 0; border-radius: 0.65rem; padding: 0.7rem 1rem; background: #2f81f7; color: white; font-weight: 700; text-decoration: none; }
			.profile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.75rem; margin-top: 1rem; }
			.profile-grid div { border: 1px solid #263a58; border-radius: 0.65rem; padding: 0.75rem; }
			.profile-grid span { display: block; color: #91a4bf; font-size: 0.75rem; margin-bottom: 0.2rem; }
			table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
			th, td { padding: 0.65rem; border-bottom: 1px solid #263a58; text-align: left; }
			th { color: #91a4bf; font-size: 0.75rem; text-transform: uppercase; }
			html[data-theme="light"] {
				color-scheme: light;
				background: #f5f8fc;
				color: #142033;
			}
			html[data-theme="light"] body { background: radial-gradient(circle at 15% 0%, #dbeafe 0, transparent 36%), #f5f8fc; }
			html[data-theme="light"] header { border-bottom-color: #cbd5e1; background: #ffffffdd; }
			html[data-theme="light"] .panel { border-color: #cbd5e1; background: #ffffffed; box-shadow: 0 2rem 5rem #64748b33; }
			html[data-theme="light"] p { color: #475569; }
			html[data-theme="light"] .meta span { border-color: #cbd5e1; color: #52627a; }
			html[data-theme="light"] .renderer { border-color: #94a3b8; background: #f8fafc; color: #24324a; }
			html[data-theme="light"] .admin-link { border-color: #94a3b8; }
			html[data-theme="light"] a { color: #1d4ed8; }
		</style>
	</head>
	<body>
		<div class="shell">
			<header>
				<div class="brand">SuperBoard</div>
				<a class="admin-link" href="/_emdash/admin">{message("site.admin.open")}</a>
			</header>
			<main>
				<section class="panel">
					{resolution.result === "rendered" ? (
						<>
							<div class="eyebrow">{message("site.front.route_manifest")}</div>
							<h1>{localizedPageTitle ?? resolution.page_id}</h1>
							<p>
								{message("site.front.description")}
							</p>
							<div class="renderers">
								{userRendererViews.map((view) => (
									<div class="renderer" data-renderer-id={view.renderer_id} data-state={view.state}>
										<h2>{message(view.title_message_id)}</h2>
										<p>{message(view.description_message_id)}</p>
										{view.kind === "login" && <a class="action" href={coreActionUrls[view.action_id]}>{message("user.action.passkey")}</a>}
										{view.kind === "profile" && (
											<div class="profile-grid">
												<div><span>{message("user.field.name")}</span><strong>{view.operator.name ?? "—"}</strong></div>
												<div><span>{message("user.field.email")}</span><strong>{view.operator.email}</strong></div>
												<div><span>{message("user.field.role")}</span><strong>{view.operator.role}</strong></div>
											</div>
										)}
										{view.kind === "members" && (
											<table>
												<thead><tr><th>{message("user.field.name")}</th><th>{message("user.field.email")}</th><th>{message("user.field.role")}</th><th>{message("user.field.status")}</th></tr></thead>
												<tbody>{view.members.map((member) => <tr><td>{member.name ?? "—"}</td><td>{member.email}</td><td>{member.role}</td><td>{message(member.disabled ? "user.status.disabled" : "user.status.active")}</td></tr>)}</tbody>
											</table>
										)}
									</div>
								))}
							</div>
						</>
					) : (
						<>
							<div class="eyebrow">{message("site.front.fail_closed")}</div>
							<h1>{stateTitle ?? message("site.front.unavailable")}</h1>
							<p>
								{message("site.front.fail_closed_description")}
							</p>
						</>
					)}
					<div class="meta">
						<span>{message("site.meta.instance")}={model.instance_id}</span>
						<span>{message("site.meta.state")}={resolution.result}</span>
						{releaseId && <span>{message("site.meta.release")}={releaseId}</span>}
						{model.release && <span>{message("site.meta.source")}={model.release.source}</span>}
					</div>
				</section>
			</main>
		</div>
	</body>
</html>
