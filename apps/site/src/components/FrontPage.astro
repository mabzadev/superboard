---
import { getEmDashEntry, getMenu } from "emdash";

import type { FrontPageModel } from "../lib/front-page.js";
import {
	editableNavigationFromMenu,
	editableViewFromEntry,
	frontViewSlug,
} from "../lib/native-front-views.js";
import { projectNativeFrontPresentation } from "../lib/native-front-presentation.js";
import { ensureSuperBoardViews } from "../lib/superboard-views.js";
import { createUserFrontI18n, resolveUserFrontRequestLocale } from "../lib/user-front-i18n.js";
import { NativeFrontApp } from "./NativeFrontApp.js";
import { resolveOperatorProjectScope } from "../lib/operator-project-scope.js";
import { getSiteEnv } from "../lib/site-env.js";

import "../styles/dashboard-views.css";
import "../styles/native-front.css";
import "../../../../packages/supbrd-front-ui/src/styles/kumo.css";

interface Props {
	model: FrontPageModel;
}

const { model } = Astro.props;
const locale = resolveUserFrontRequestLocale(Astro.request);
Astro.response.headers.set("Content-Language", locale);
let configuration;
if (model.resolution.result === "rendered" && model.operator) {
	await ensureSuperBoardViews(Astro.locals.emdash.db);
	const route = model.release?.release.payload.front_route_manifest.routes.find(({ route_id }) => route_id === model.resolution.route_id);
	const [menu, viewResult] = await Promise.all([
		getMenu("superboard-admin", { locale }),
		getEmDashEntry("views", frontViewSlug(route?.path_pattern ?? model.requested_path)),
	]);
	if (Astro.cache?.enabled) Astro.cache.set(viewResult.cacheHint);
	configuration = {
		navigation: editableNavigationFromMenu(menu),
		view: editableViewFromEntry(viewResult.entry),
	};
}
const projection = projectNativeFrontPresentation(model, locale, configuration);
projection.operator = model.operator;
if (model.operator && model.resolution.result === "rendered" && projection.content_mounts.some(({ renderer }) => renderer.plugin_id !== "supbrd-core")) {
	try { projection.project_scope = await resolveOperatorProjectScope(getSiteEnv(), model.operator); }
	catch { /* The authenticated POST bootstrap resolves absent core projections in the client. */ }
}
const i18n = createUserFrontI18n(locale);
const viewTitle = projection.content_mounts[0]?.view_title ?? model.page_title;
const title = viewTitle ? (Object.hasOwn(projection.messages, viewTitle) ? i18n._(viewTitle) : viewTitle) : i18n._("site.front.title");
---

<!doctype html>
<html lang={locale} dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
	</head>
	<body>
		<NativeFrontApp projection={projection} client:only="react" />
	</body>
</html>
