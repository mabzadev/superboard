---
import type { FrontPageModel } from "../lib/front-page.js";
import { projectNativeFrontPresentation } from "../lib/native-front-presentation.js";
import { createUserFrontI18n, resolveUserFrontLocale } from "../lib/user-front-i18n.js";
import { NativeFrontApp } from "./NativeFrontApp.js";

interface Props {
	model: FrontPageModel;
}

const { model } = Astro.props;
const requestedLocale = Astro.url.searchParams.get("lang")
	?? Astro.request.headers.get("accept-language");
const locale = resolveUserFrontLocale(requestedLocale);
const projection = projectNativeFrontPresentation(model, locale);
const i18n = createUserFrontI18n(locale);
const title = model.page_title ? i18n._(model.page_title) : i18n._("site.front.title");
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
	</head>
	<body>
		<NativeFrontApp projection={projection} />
	</body>
</html>
