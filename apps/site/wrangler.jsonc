{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "superboard-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "superboard-site",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "superboard-site-media" }],
	"kv_namespaces": [{ "binding": "SESSION" }, { "binding": "RELEASE_CACHE" }],
	"worker_loaders": [{ "binding": "LOADER" }],
	"services": [{ "binding": "API_SERVICE", "service": "superboard-api-dev" }],
	"vars": {
		"SUPERBOARD_INSTANCE_ID": "local",
		"SUPERBOARD_RELEASE_OPERATIONS": "disabled"
	},
	"triggers": { "crons": ["* * * * *"] },
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	}
}
