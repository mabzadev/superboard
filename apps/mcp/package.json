{
  "name": "@superboard/mcp-server",
  "mcpName": "io.superboard/mcp",
  "version": "1.0.0",
  "description": "Target-configured MCP operator interface for infrastructure status, projects, links, attribution, analytics, campaigns, and SDK configuration on SuperBoard.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mabzadev/superboard.git",
    "directory": "apps/mcp"
  },
  "keywords": [
    "mcp",
    "deep-links",
    "mobile",
    "analytics",
    "attribution",
    "app-links",
    "universal-links",
    "mobile-attribution",
    "tracking-links",
    "campaigns",
    "superboard"
  ],
  "author": "SuperBoard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mabzadev/superboard/issues"
  },
  "homepage": "https://github.com/mabzadev/superboard/tree/main/apps/mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  }
}
