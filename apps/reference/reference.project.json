{
	"$schema": "schemas/reference-project.schema.json",
	"schemaVersion": 4,
	"name": "SuperBoard Reference",
	"platformRepository": "https://github.com/mabzadev/superboard",
	"referenceRepository": "https://github.com/mabzadev/superboard",
	"referencePath": "apps/reference",
	"environment": "development",
	"target": "mabza-development",
	"sdkApplication": {
		"platform": "web",
		"identifier": "reference.mabza.dev",
		"projectEnvironment": "test"
	},
	"deployment": {
		"branch": "dev",
		"environment": "development",
		"logicalName": "superboard-reference",
		"workerName": "superboard-reference-app-dev",
		"resourceIdentity": "legacy-compatible",
		"compatibilityDate": "2026-08-08"
	},
	"endpoints": {
		"referenceWeb": "https://reference.mabza.dev",
		"dashboard": "https://board.mabza.dev",
		"api": "https://api.mabza.dev",
		"sdk": "https://sdk.mabza.dev",
		"shortLinks": "https://in.mabza.dev",
		"files": "https://files.mabza.dev",
		"mailPreview": "https://mail.mabza.dev",
		"support": "https://api.mabza.dev/api/v1/support-client"
	},
	"sdkCatalogue": {
		"schemaVersion": 4,
		"coverageManifest": "config/sdk-coverage.json",
		"promotionPolicy": "complete-active-set",
		"active": ["flutter", "flutterflow"],
		"internal": ["android", "ios"],
		"archived": ["flutterflow-support", "javascript", "react-native"]
	},
	"libraries": {
		"superboard_flutterflow": {
			"path": "sdks/flutterflow",
			"developmentRef": "dev",
			"sourceVersion": "4.0.0",
			"releaseVersion": "2.2.5",
			"releaseRef": "sdk-flutterflow-v2.2.5"
		}
	}
}
