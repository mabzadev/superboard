{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"tests/checks/**/*.test.{ts,tsx,mjs}",
				"tests/e2e/**/*.{ts,mjs}",
				"tests/lints/*.{mjs,ts}",
				"scripts/**/*.{mjs,ts}",
				"tests/fixtures/site-browser/business-actions.mjs",
				"tests/checks/**/env.d.ts"
			],
			"project": ["tests/**/*.{ts,tsx,mjs}", "scripts/**/*.{ts,mjs}"]
		},
		"packages/core": {
			"entry": ["src/astro/**/*.ts", "src/db/*.ts", "src/storage/*.ts"],
			"ignoreDependencies": [
				"cloudflare",
				"@aws-sdk/client-s3",
				"@aws-sdk/s3-request-presigner",
				"@vitest/coverage-v8"
			]
		},
		"packages/auth": {
			"ignoreDependencies": ["cloudflare", "kysely"]
		},
		"packages/admin": {},
		"packages/gutenberg-to-portable-text": {},
		"packages/plugins/*": {},
		"packages/cloudflare": {
			"ignoreDependencies": ["cloudflare"]
		},
		"sdks/web": {
			"entry": [
				"src/index.js",
				"src/client.js",
				"src/support.js",
				"dist/identity/index.js",
				"dist/flows/**/*.mjs",
				"dist/**/*.d.ts"
			]
		},
		"packages/plugins/superboard-monetization/billing": {
			"vitest": {
				"config": ["vitest*.config.ts"]
			},
			"wrangler": {
				"config": ["wrangler*.jsonc"]
			}
		},
		"packages/plugins/superboard-authentification/worker": {
			"entry": ["src/index.ts", "src/melody/node.tsx"],
			"wrangler": {
				"config": ["wrangler.jsonc"]
			},
			"vitest": {
				"config": ["vitest*.config.ts"]
			}
		}
	},
	"ignore": [
		"**/dist/**",
		"!sdks/web/dist/**",
		"**/*.d.ts",
		"!sdks/web/dist/**/*.d.ts",
		"sdks/web/flows/upstream/**",
		"**/worker-configuration.d.ts",
		"**/generated/**",
		"**/.symlinks/**",
		"**/Pods/**",
		"**/.dart_tool/**",
		"**/build/**",
		"!tests/checks/**/env.d.ts"
	],
	"ignoreDependencies": ["@changesets/cli"],
	"ignoreWorkspaces": ["sdks/flutter/example", "sdks/web/flows/upstream/**"],
	"babel": false,
	"ignoreIssues": {
		"sdks/web/package.json": ["optionalPeerDependencies"]
	}
}
