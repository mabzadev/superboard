{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opengrow-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["INTERNAL_API_TOKEN"] },
  "d1_databases": [{ "binding": "DB", "database_name": "opengrow-app-db", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }]
}
