{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types"],
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": "./src/melody",
    "paths": {
      "configs": ["configs/index.ts"],
      "configs/*": ["configs/*"],
      "dtos": ["dtos/index.ts"],
      "dtos/*": ["dtos/*"],
      "handlers": ["handlers/index.ts"],
      "handlers/*": ["handlers/*"],
      "hooks": ["hooks/index.ts"],
      "hooks/*": ["hooks/*"],
      "middlewares": ["middlewares/index.ts"],
      "middlewares/*": ["middlewares/*"],
      "models": ["models/index.ts"],
      "models/*": ["models/*"],
      "pages": ["pages/index.ts"],
      "pages/*": ["pages/*"],
      "router": ["router.tsx"],
      "routes": ["routes/index.ts"],
      "routes/*": ["routes/*"],
      "services": ["services/index.ts"],
      "services/*": ["services/*"],
      "templates": ["templates/index.ts"],
      "templates/*": ["templates/*"],
      "utils": ["utils/index.ts"],
      "utils/*": ["utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/tests/**",
    "src/melody/adapters/**",
    "src/melody/node.tsx",
    "src/melody/node_compat.tsx"
  ]
}
