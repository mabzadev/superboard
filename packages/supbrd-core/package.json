{
	"name": "@superboard/supbrd-core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "schemas"],
	"scripts": {
		"schema:generate": "node scripts/generate-front-release-validator.mjs",
		"schema:check": "node scripts/generate-front-release-validator.mjs --check",
		"build": "tsdown",
		"prebuild": "pnpm run schema:check",
		"dev": "tsdown --watch",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"ajv": "^8.17.1",
		"fast-deep-equal": "^3.1.3",
		"fast-uri": "^3.0.1",
		"json-schema-traverse": "^1.0.0",
		"require-from-string": "^2.0.2",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
