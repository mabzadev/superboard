---
import { Vimeo as AstroVimeo } from "astro-embed";
import type { VimeoBlock } from "../schemas.js";

interface Props {
	node: VimeoBlock;
}

const { node } = Astro.props;
const { id, poster, posterQuality, params, playlabel } = node;
---

<AstroVimeo
	id={id}
	poster={poster}
	posterQuality={posterQuality}
	params={params}
	playlabel={playlabel}
/>
