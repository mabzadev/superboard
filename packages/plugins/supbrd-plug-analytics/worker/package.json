{
  "name": "@superboard/analytics-worker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "cd ../../../.. && node packages/plugins/supbrd-plug-analytics/worker/node_modules/eslint/bin/eslint.js --config packages/plugins/supbrd-plug-analytics/worker/eslint.config.mjs packages/plugins/supbrd-plug-analytics/worker/src tests/checks/plugins/supbrd-plug-analytics/worker packages/plugins/supbrd-plug-analytics/worker/vitest.config.ts packages/plugins/supbrd-plug-analytics/worker/vitest.runtime.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.runtime.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "types": "node ../../../../scripts/cloudflare/types.mjs --service analytics --reference --allow-unprovisioned"
  },
  "dependencies": {
    "@superboard/contracts": "workspace:*",
    "hono": "catalog:workers"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:workers",
    "@typescript-eslint/parser": "catalog:workers",
    "@cloudflare/vitest-pool-workers": "catalog:workers",
    "@cloudflare/workers-types": "catalog:workers",
    "eslint": "catalog:workers",
    "typescript": "catalog:workers",
    "vitest": "catalog:",
    "wrangler": "catalog:workers"
  }
}
