{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types"],
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "configs": ["./src/melody/configs/index.ts"],
      "configs/*": ["./src/melody/configs/*"],
      "dtos": ["./src/melody/dtos/index.ts"],
      "dtos/*": ["./src/melody/dtos/*"],
      "handlers": ["./src/melody/handlers/index.ts"],
      "handlers/*": ["./src/melody/handlers/*"],
      "hooks": ["./src/melody/hooks/index.ts"],
      "hooks/*": ["./src/melody/hooks/*"],
      "middlewares": ["./src/melody/middlewares/index.ts"],
      "middlewares/*": ["./src/melody/middlewares/*"],
      "models": ["./src/melody/models/index.ts"],
      "models/*": ["./src/melody/models/*"],
      "pages": ["./src/melody/pages/index.ts"],
      "pages/*": ["./src/melody/pages/*"],
      "router": ["./src/melody/router.tsx"],
      "routes": ["./src/melody/routes/index.ts"],
      "routes/*": ["./src/melody/routes/*"],
      "services": ["./src/melody/services/index.ts"],
      "services/*": ["./src/melody/services/*"],
      "templates": ["./src/melody/templates/index.ts"],
      "templates/*": ["./src/melody/templates/*"],
      "utils": ["./src/melody/utils/index.ts"],
      "utils/*": ["./src/melody/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/tests/**",
    "src/melody/adapters/**",
    "src/melody/node.tsx",
    "src/melody/node_compat.tsx"
  ]
}
