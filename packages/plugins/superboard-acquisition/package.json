{
	"name": "@superboard/plugin-journeys",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./front/*": "./src/front/*",
		"./*": "./src/*.ts"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "node ../../supbrd-core/scripts/build-plugin.mjs",
