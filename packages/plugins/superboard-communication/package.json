{
	"name": "@superboard/plugin-communication",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./front/*": "./src/front/*",
		"./*": "./src/*.ts"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "node ../../supbrd-core/scripts/build-plugin.mjs",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@superboard/front-ui": "workspace:*",
		"react": "catalog:",
		"@types/react": "catalog:",
		"@superboard/contracts": "workspace:*",
		"@craftjs/core": "^0.2.12",
		"react-dom": "catalog:",
		"@types/react-dom": "catalog:",
		"zod": "^4.3.6",
		"lucide-react": "^0.525.0"
	},
	"devDependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-table": "^8.21.3",
		"@testing-library/react": "^16.3.2",
		"@vitest/coverage-v8": "4.1.5",
		"@xyflow/react": "^12.11.3",
		"axios": "^1.19.0",
		"clsx": "^2.1.1",
		"jsdom": "26.1.0",
		"react-hook-form": "^7.71.2",
		"typescript": "catalog:",
		"vitest": "4.1.5"
	},
	"license": "MIT"
}
