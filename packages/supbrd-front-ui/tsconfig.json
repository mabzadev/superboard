{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"lib": ["es2023", "dom", "dom.iterable"]
	},
	"include": ["src"]
}
