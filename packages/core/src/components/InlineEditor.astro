---
import { InlinePortableTextEditor } from "./InlinePortableTextEditor";

export interface Props {
	value: unknown[];
	collection: string;
	entryId: string;
	field: string;
}

const { value, collection, entryId, field } = Astro.props;
---

<InlinePortableTextEditor
	client:only="react"
	value={value}
	collection={collection}
	entryId={entryId}
	field={field}
/>
